{
  "name": "voxy",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "pnpm@10.30.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "biome check .",
    "test": "tsx --test packages/*/src/*.test.ts",
    "arkiv:status": "node --env-file=.env --import tsx packages/arkiv/src/cli.ts status",
    "arkiv:first-write": "node --env-file=.env --import tsx packages/arkiv/src/cli.ts first-write",
    "arkiv:query": "node --env-file=.env --import tsx packages/arkiv/src/cli.ts query",
    "attester:roster": "node --env-file=.env --import tsx packages/attester/src/cli.ts roster",
    "attester:verify-sync": "node --env-file=.env --import tsx packages/attester/src/cli.ts verify-sync",
    "attester:sync": "node --env-file=.env --import tsx packages/attester/src/cli.ts sync",
    "recover": "node --env-file=.env --import tsx packages/orchestrator/src/cli.ts",
    "watcher": "node --env-file=.env --import tsx packages/watcher/src/cli.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "demo": "tsx scripts/demo.ts",
    "attacks": "tsx scripts/attacks.ts",
    "measure": "tsx scripts/measure.ts",
    "voxy:request": "node --env-file=.env --import tsx packages/orchestrator/src/sovereign-cli.ts request",
    "voxy:sign": "node --env-file=.env --import tsx packages/orchestrator/src/sovereign-cli.ts sign",
    "voxy:recover": "node --env-file=.env --import tsx packages/orchestrator/src/sovereign-cli.ts recover",
    "test:api": "forge build --root contracts/devnet && node --import tsx --test apps/api/src/*.test.ts",
    "test:ens": "forge build --root contracts/devnet --quiet && forge build --root contracts/sepolia --quiet && node --import tsx apps/api/scripts/verify-ens.mjs",
    "eoa:build": "forge build --root contracts/sepolia --quiet && node apps/api/scripts/build-eoa-artifacts.mjs",
    "eoa:deploy:plan": "node --env-file=.env apps/api/scripts/deploy-eoa.mjs",
    "eoa:deploy": "node --env-file=.env apps/api/scripts/deploy-eoa.mjs --broadcast",
    "test:eoa": "forge build --root contracts/sepolia --quiet && node --import tsx apps/api/scripts/verify-eoa-local.mjs",
    "test:eoa:live": "node --env-file=.env apps/web/scripts/verify-live-wallet.mjs --public-write-approved"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/node": "^24.0.0",
    "axe-core": "^4.14.0",
    "playwright": "^1.65.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "viem": "^2.38.0"
  }
}
